# Copy to .env.local (git-ignored) and restart `npx expo start` after changing.
# Only PUBLIC values go here — never Supabase service keys, Quick or Agora secrets.

# Backend from Teammate 3. Use your laptop's LAN IP, not "localhost":
# the phone is a different device. Leave empty to use the built-in mock.
EXPO_PUBLIC_API_BASE_URL=

# Force the mock even when a backend URL is set (rehearsals, offline demos).
EXPO_PUBLIC_USE_MOCK=false

# Seconds × 1000 before a request is treated as timed out.
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=30000

# Default UI chrome language: en | bik. Switch to bik only after the Bikol
# strings in src/i18n/copy.ts are native-reviewed.
EXPO_PUBLIC_UI_LANG=en

# Show the Listen button. Only after the Agora/TTS route passes the
# native-speaker pronunciation check.
EXPO_PUBLIC_ENABLE_LISTEN=false
