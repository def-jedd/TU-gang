# Copy to .env.local (git-ignored) and restart `npx expo start` after changing.
# Only PUBLIC values go here — never Supabase service keys, Quick or Agora secrets.

# The tutor API (apps/bikol-rag-cli/server.py). Leave empty to use the built-in mock.
#   auto = the API runs on the same computer as `npx expo start`; the app follows
#          that computer's address on any Wi-Fi or hotspot (port below).
#   Or a full URL, e.g. http://192.168.1.23:8000 (server.py prints it). Never
#   "localhost": the phone is a different device.
EXPO_PUBLIC_API_BASE_URL=auto
# 3000 = Kiev's apps/server (front door: forwards to Jed's tutor and stores
# answers so the Agora voice can speak them). 8000 = Jed's tutor directly (no Agora).
EXPO_PUBLIC_API_PORT=3000

# Force the mock even when a backend URL is set (rehearsals, offline demos).
EXPO_PUBLIC_USE_MOCK=false

# Seconds × 1000 before a request is treated as timed out. The local Ollama
# placeholder makes four model calls per answer, so allow 90 s.
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=90000

# Default UI chrome language: en | bik. Switch to bik only after the Bikol
# strings in src/i18n/copy.ts are native-reviewed.
EXPO_PUBLIC_UI_LANG=en

# Agora MiniMax voice (Kiev's apps/server): the main voice in calls and the
# Listen button. Needs the dev build; otherwise the phone voice is used.
EXPO_PUBLIC_ENABLE_LISTEN=true
# Kiev's voice server: auto = this computer, port below (his default 3000).
EXPO_PUBLIC_VOICE_API_BASE_URL=auto
EXPO_PUBLIC_VOICE_API_PORT=3000

# ── Voice ───────────────────────────────────────────────────────────────
# simulated = practice voice (device speech, works in Expo Go, can't hear).
# agora     = live Agora tutor. Needs the dev build + backend /api/voice/sessions
#             (see VOICE_CONTRACT.md). Falls back to practice with a notice.
EXPO_PUBLIC_VOICE_MODE=simulated

# voice (default) = cards/Explain start a call. text = reading flow instead.
EXPO_PUBLIC_INTERACTION=voice

# Speak button labels aloud when tapped (for students who can't read).
EXPO_PUBLIC_SPOKEN_LABELS=true

# Show captions during calls by default (judges, teachers, read-along).
EXPO_PUBLIC_CAPTIONS=false
