{
  "expo": {
    "name": "TU-gang",
    "slug": "tu-gang",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tugang",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.tugang.tutor",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "TU-gang uses the microphone so you can talk with your tutor."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EAF4FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tugang.tutor",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.NFC"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EAF4FF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "TU-gang reads learning cards so you can choose a lesson by tapping a card."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ae46cd0f-87a0-4256-81c9-1874b4193235"
      }
    },
    "owner": "jjoshua-sek"
  }
}
