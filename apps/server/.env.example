# Copy to .env.local (git-ignored) and fill in. Never put these in the mobile app.
PORT=3000

# Supabase: Dashboard → Project Settings → API Keys (secret key, backend only)
SUPABASE_URL=https://dpkhzerwfgxuarmuumlf.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Agora Console → Projects → ⋯ → Credentials (copy the .env block)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Jed's Python tutor (apps/bikol-rag-cli: python server.py). Express forwards
# /api/explain there and remembers each answer so Listen can speak it.
TUTOR_UPSTREAM_URL=http://localhost:8000
TUTOR_TIMEOUT_MS=90000

# Live voice calls (Agora agent -> Gemini). Leave unset to reuse the key in
# apps/bikol-rag-cli/.env. Backend only: never in the mobile app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Approved in round-1 voice test: minimax-english (default) | minimax-filipino-boost
VOICE_TTS=minimax-english

# Serves /voice-test and dev-only helper routes. Set false for the demo deployment.
ENABLE_VOICE_TEST_PAGE=true
